# Database
DATABASE_URL=postgres://aula:aula@127.0.0.1:55433/aula

# Auth.js (AUTH_URL = den adresse siden nås på)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Discord-server og officer-rolle
DISCORD_GUILD_ID=
DISCORD_OFFICER_ROLE_ID=

# Blizzard (ny nøgle, aldrig den der blev delt i chat)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_GUILD_SLUG=aula
BLIZZARD_GUILD_ID=304114

# Cron/planlægger
CRON_SECRET=
SYNC_ENABLED=false
AUTO_MIGRATE=false

# Filer og galleri (uploads gemmes på disken; mappen skal med i backup)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
MAX_TOTAL_MB=2048

# Chat (valgfri, læsning og skrivning i én Discord-kanal under menupunktet «Beskeder»)
# Begge skal være sat, ellers vises chatten ikke. Opret en SEPARAT bot i Discords udviklerportal;
# genbrug ALDRIG token fra broen mellem spillet og Discord. Inviter botten til serveren med
# rettighederne «Se kanal», «Læs beskedhistorik» og «Send beskeder» (uden den sidste kan
# botten kun læse), og slå «Message Content Intent» til under
# Bot i udviklerportalen, ellers er beskedteksterne tomme. Botten inviteres med scope «bot».
# Kanal-id: slå Udviklertilstand til i Discord (Indstillinger > Avanceret), højreklik på kanalen
# og vælg «Kopiér kanal-ID». Det er et langt tal. Ugyldig opsætning slår kun chatten fra.
DISCORD_BOT_TOKEN=
DISCORD_CHAT_CHANNEL_ID=

# Sim (valgfri): adressen på simc-worker (se simc-worker/README.md), fx http://simc:8080.
# Ikke sat = Sim-siden og menupunktet er slået fra. Kun http/https.
SIMC_WORKER_URL=
