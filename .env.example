# Database
DATABASE_URL=postgres://aula:aula@127.0.0.1:55433/aula

# Auth.js (AUTH_URL = den adresse siden nås på)
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Login med Battle.net (Blizzards udviklerportal). Tomme = BLIZZARD_CLIENT_ID/-SECRET bruges,
# så én Blizzard-klient kan klare både login og API. Redirect-adressen skal være registreret
# på klienten: <AUTH_URL>/api/auth/callback/battlenet (se README).
AUTH_BATTLENET_ID=
AUTH_BATTLENET_SECRET=

# Blizzard API (ny nøgle, aldrig den der blev delt i chat)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_GUILD_SLUG=aula
BLIZZARD_GUILD_ID=304114

# Officer: højeste guild-rang (0 = guildmester) med en verificeret karakter, der giver officer-adgang.
OFFICER_MAX_RANK=1

# Cron/planlægger
CRON_SECRET=
SYNC_ENABLED=false
AUTO_MIGRATE=false

# Filer og galleri (uploads gemmes på disken; mappen skal med i backup)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
MAX_TOTAL_MB=2048

# Sim (valgfri): adressen på simc-worker (se simc-worker/README.md), fx http://simc:8080.
# Ikke sat = Sim-siden og menupunktet er slået fra. Kun http/https.
SIMC_WORKER_URL=
