+    const dot_t* d = p()->immolate_action ? p()->immolate_action->find_dot( t ) : nullptr;
+    if ( d && d->is_ticking() )
+      m *= 1.0 + data().effectN( 2 ).percent();
+    return m;
+  }
+};
