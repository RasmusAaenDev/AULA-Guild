+  water_shield_icd->start();
+  resource_gain( RESOURCE_MANA, find_spell( 408511 )->effectN( 1 ).percent() * resources.max[ RESOURCE_MANA ],
+                 gains.water_shield );
+  buff.water_shield->decrement();
+}
